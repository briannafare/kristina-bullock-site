  "global_components": {
    "nav_header": {
      "component": "components/layout/NavHeader.tsx",
      "layout": "sticky top-0 z-50, max-w-full",
      "design": {
        "bg": "bg-white/92 backdrop-blur-md",
        "border": "border-b border-[#E5E2DC]",
        "height": "h-[72px]",
        "transition": "Add shadow-sm on scroll via scroll listener"
      },
      "elements": {
        "logo": "Left — 'Kristina Bullock Real Estate' in DM Sans font-semibold text-[#1C1C1C], or logo image if provided",
        "nav_links": "Center — Home, Buying, Selling, Investing, About, Neighborhoods | DM Sans weight-500 text-sm tracking-wide",
        "phone": "Right — 503-382-7798 as click-to-call, hidden on mobile",
        "cta": "Right — 'Schedule a Call' button in accent #C17B5D, rounded-lg, px-6 py-2.5",
        "mobile": "Hamburger → full-screen overlay drawer. Phone number prominent at top of drawer. All nav links. CTA button at bottom."
      },
      "framer_motion": {
        "entrance": "none (always visible)",
        "scroll": "useMotionValueEvent to add shadow on scroll > 50px"
      }
    },

    "footer": {
      "component": "components/layout/Footer.tsx",
      "layout": "full-width, bg-[#2D4A3E] text-white",
      "design": {
        "padding": "py-16 md:py-20",
        "grid": "4-column on desktop, stacked on mobile"
      },
      "elements": {
        "col_1": "Brand name + tagline + license info + Equal Housing logo",
        "col_2": "Quick links: Home, Buying, Selling, Investing, About, Neighborhoods, Contact, FAQ",
        "col_3": "Service areas: Portland, Beaverton, Lake Oswego, Tigard, Gresham, Hillsboro",
        "col_4": "Contact: Phone, Email, Hours, Google review badge",
        "bottom_bar": "© 2026 Kristina Bullock Real Estate | eXp Realty, LLC | Privacy Policy | Terms"
      }
    },

    "sticky_mobile_cta": {
      "component": "components/layout/StickyMobileCTA.tsx",
      "layout": "fixed bottom-0 w-full z-40, md:hidden",
      "design": {
        "bg": "bg-[#C17B5D]",
        "text": "text-white font-semibold",
        "padding": "py-4 px-6",
        "shadow": "shadow-2xl"
      },
